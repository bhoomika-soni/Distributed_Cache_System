# Copy to .env for Docker Compose (Phase 10). For local runs every variable
# has a default, so you can start the services without setting anything.

# --- Shared by all services -------------------------------------------------
# Shared secret that protects /internal/* endpoints. CHANGE IT outside local dev.
CLUSTER_SECRET=change-me-in-production

# --- Gateway ----------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# Cluster registry: comma-separated node_id=base_url pairs
NODES=node-1=http://localhost:8001,node-2=http://localhost:8002,node-3=http://localhost:8003
REPLICATION_FACTOR=3
VIRTUAL_NODES=100
HEALTH_CHECK_INTERVAL=5
REQUEST_TIMEOUT=2.0
MAX_RETRIES=2

# --- Cache node (one set per node) -------------------------------------------
NODE_ID=node-1
NODE_HOST=0.0.0.0
NODE_PORT=8001
CACHE_CAPACITY=1000
TTL_CLEANUP_INTERVAL=1.0
# Primary -> replica replication
REPLICATION_TIMEOUT=2.0   # seconds per replication request
REPLICATION_RETRIES=2     # extra attempts after the first; failures are recorded, never dropped
TOMBSTONE_TTL=300         # seconds to remember versions of deleted/evicted keys
